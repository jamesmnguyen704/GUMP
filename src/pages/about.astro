---
import Layout from '../layouts/Layout.astro';

type Tier = "Core" | "Working" | "Exploring";

type SkillGroup = {
    title: string;
    blurb: string;
    skills: { name: string; tier: Tier }[];
};

const groups: SkillGroup[] = [
    {
        title: "Programming & AI",
        blurb: "Where I spend most of my build time right now.",
        skills: [
            { name: "Python", tier: "Core" },
            { name: "SQL", tier: "Core" },
            { name: "JavaScript", tier: "Working" },
            { name: "TypeScript", tier: "Exploring" },
            { name: "Claude Code", tier: "Core" },
            { name: "Anthropic SDK", tier: "Working" },
            { name: "MCP", tier: "Working" },
            { name: "Prompt Engineering", tier: "Working" },
            { name: "LLM Orchestration", tier: "Working" },
            { name: "Multi-Model Evaluation (Claude, GPT, Gemini)", tier: "Working" },
            { name: "AI Capability Auditing", tier: "Working" },
            { name: "Ollama (local LLMs)", tier: "Working" },
            { name: "n8n", tier: "Exploring" },
        ],
    },
    {
        title: "Data & Engineering",
        blurb: "Turning messy source systems into something you can actually query.",
        skills: [
            { name: "pandas", tier: "Core" },
            { name: "NumPy", tier: "Core" },
            { name: "FastAPI", tier: "Working" },
            { name: "SQLite", tier: "Working" },
            { name: "pytest", tier: "Working" },
            { name: "OCR / PDF Text Extraction", tier: "Working" },
            { name: "SQLAlchemy", tier: "Exploring" },
            { name: "Alembic", tier: "Exploring" },
            { name: "PostgreSQL", tier: "Exploring" },
            { name: "DuckDB", tier: "Exploring" },
            { name: "Database Schema Design", tier: "Working" },
            { name: "ETL", tier: "Working" },
            { name: "Data Scraping", tier: "Working" },
            { name: "openpyxl", tier: "Working" },
        ],
    },
    {
        title: "Machine Learning",
        blurb: "Classical ML where I've shipped measurable results, plus what I'm building toward.",
        skills: [
            { name: "scikit-learn", tier: "Core" },
            { name: "Decision Trees / Random Forest", tier: "Core" },
            { name: "Logistic Regression", tier: "Core" },
            { name: "LightGBM", tier: "Working" },
            { name: "XGBoost", tier: "Working" },
            { name: "CatBoost", tier: "Working" },
            { name: "NLP (NLTK, spaCy, transformers)", tier: "Working" },
            { name: "TensorFlow / Keras (CNNs)", tier: "Working" },
            { name: "Time Series Forecasting", tier: "Working" },
            { name: "LoRA Fine-Tuning (kohya)", tier: "Working" },
            { name: "ComfyUI / Diffusion Pipelines", tier: "Working" },
            { name: "PyTorch", tier: "Exploring" },
        ],
    },
    {
        title: "Full-Stack Web",
        blurb: "The SavvyCoders stack — built a real capstone in it.",
        skills: [
            { name: "Node.js", tier: "Working" },
            { name: "Express", tier: "Working" },
            { name: "MongoDB", tier: "Working" },
            { name: "Mongoose", tier: "Working" },
            { name: "REST APIs", tier: "Working" },
            { name: "HTML / CSS", tier: "Working" },
            { name: "Astro", tier: "Working" },
            { name: "Git / GitHub", tier: "Core" },
            { name: "VS Code", tier: "Core" },
            { name: "Netlify", tier: "Working" },
            { name: "Docker", tier: "Exploring" },
        ],
    },
    {
        title: "Finance & Enterprise Systems",
        blurb: "The foundation — still shapes how I think about controls, audit trails, and data integrity.",
        skills: [
            { name: "Account Reconciliation", tier: "Core" },
            { name: "General Ledger", tier: "Core" },
            { name: "AP / AR", tier: "Core" },
            { name: "Fixed Assets", tier: "Core" },
            { name: "Financial Reporting", tier: "Core" },
            { name: "QuickBooks Enterprise", tier: "Core" },
            { name: "SAP", tier: "Working" },
            { name: "Oracle", tier: "Working" },
            { name: "Excel (advanced)", tier: "Core" },
            { name: "Sage FAS", tier: "Working" },
        ],
    },
    {
        title: "Business Domains",
        blurb: "Where my work has made real decisions.",
        skills: [
            { name: "Renewable Energy / Solar Operations", tier: "Working" },
            { name: "Regulatory Compliance", tier: "Working" },
            { name: "Tax Credit Research (ITC, Domestic Content)", tier: "Working" },
            { name: "ERP Design", tier: "Working" },
            { name: "ERP Migration", tier: "Working" },
            { name: "Multi-state Sales Tax", tier: "Core" },
            { name: "Period Close", tier: "Core" },
            { name: "Audit Response", tier: "Working" },
        ],
    },
];

const principles = [
    "One fact, one owner. Reports explain the truth; they don't get to own it.",
    "Fail closed near money. Automation prepares the work; a person approves it.",
    "Unknown is a real state. Missing is not zero, and stale is not current.",
    "Check the grant, not the description. A claim needs evidence before I build on it.",
    "Controls, audit trails, and reversible operations by default.",
];
---

<Layout title="About" description="James Nguyen: finance and operations analyst who builds software. A decade of accounting and reconciliation, now building data pipelines, finance automation, and AI workflows.">
    <section class="about-header">
        <h1>About</h1>
        <p class="intro">
            I'm a finance and operations analyst who builds software. I spent a decade reconciling
            data across messy enterprise systems, learned data science and full-stack development,
            and now build the internal tools a commercial solar contractor runs its back office on.
            I understand the accounting well enough to know where automation should stop and ask a person.
        </p>
    </section>

    <section class="now">
        <h2>What I'm doing now</h2>
        <ul class="now-list">
            <li>
                <span class="now-label">Building</span>
                <span class="now-value">
                    The internal operations platform at Day &amp; Night Solar: data pipelines, QuickBooks
                    automation, reconciliation, document extraction, and a governed AI agent workflow.
                </span>
            </li>
            <li>
                <span class="now-label">On my own time</span>
                <span class="now-value">
                    Atlas, my local-first personal data lakehouse · a solar lab in the garage ·
                    still shipping updates to Cinemetrics.
                </span>
            </li>
            <li>
                <span class="now-label">Writing</span>
                <span class="now-value">
                    Short <a href="/blog#lessons">lessons</a> from what breaks: source of truth, failing closed,
                    stale data, and keeping AI agents honest.
                </span>
            </li>
            <li>
                <span class="now-label">Open to</span>
                <span class="now-value">
                    Full-time roles where accounting, data, and code meet: finance systems, analytics
                    engineering, data and automation engineering, and internal tools.
                </span>
            </li>
        </ul>
    </section>

    <section class="journey">
        <h2>The path here</h2>
        <p>
            I spent a decade in accounting — general ledger, reconciliations, fixed assets, AP/AR
            across enterprise ERPs at NTT, Curtiss-Wright, Robert Half, and Walmart eCommerce. Before
            that, I ran my own service business for 13 years: full P&amp;L, payroll, state compliance,
            a team of six, and 10–12% YoY revenue growth through digital marketing.
        </p>
        <p>
            The through-line has always been reconciling high-volume financial data across messy source
            systems. What changed is the tools — first Excel, then Python, then ML models from the
            TripleTen data science program (16 end-to-end projects: churn, pricing, forecasting, NLP,
            a CNN regression), and now full-stack from SavvyCoders. Today I design AI-assisted workflows
            and agent-based systems on Claude Code, build domain-specific databases and tooling, and
            work at the intersection of finance, operations, and automation.
        </p>
        <p>
            Right now that means the internal operations platform at Day &amp; Night Solar, a commercial
            solar and energy-storage contractor, where I'm the sole developer and still do the finance
            work it supports — and writing down what breaks while I build it.
        </p>
    </section>

    <section class="learning">
        <h2>How I learn</h2>
        <p class="learn">
            I learn best by building something real enough to break. Usually a real problem comes first.
            I research enough to build, use AI to shorten the feedback loop, and when the AI's explanation
            doesn't match what the system actually does, I go inspect the system. I make a prediction,
            measure what happened, and turn the difference into a rule I can reuse. I keep the original
            data so I can re-check an answer instead of trusting it because it sounds right.
        </p>
    </section>

    <section class="principles">
        <h2>How I work</h2>
        <ul class="principles-list">
            {principles.map(p => <li>{p}</li>)}
        </ul>
    </section>

    <section class="skills">
        <h2>Skills</h2>
        <p class="skills-key">
            <span class="tier-dot tier-core"></span> <strong>Core</strong> — used regularly, confident
            <span class="dot-sep"></span>
            <span class="tier-dot tier-working"></span> <strong>Working</strong> — shipped with it, still growing
            <span class="dot-sep"></span>
            <span class="tier-dot tier-exploring"></span> <strong>Exploring</strong> — actively learning
        </p>
        <div class="skill-groups">
            {groups.map(group => (
                <div class="skill-group">
                    <h3>{group.title}</h3>
                    <p class="blurb">{group.blurb}</p>
                    <div class="skill-list">
                        {group.skills.map(skill => (
                            <span class={`skill-pill tier-${skill.tier.toLowerCase()}`}>
                                <span class="pill-dot" aria-hidden="true"></span>
                                {skill.name}
                            </span>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>

<style>
    .about-header { margin: 4rem 0 2rem; }
    .about-header h1 { font-size: 3rem; margin-bottom: 1.5rem; }
    .intro {
        font-size: 1.15rem;
        line-height: 1.7;
        max-width: 780px;
        color: #ddd;
    }

    section { margin: 3rem 0; }
    section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #222;
    }

    .now-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.75rem;
        max-width: 780px;
    }
    .now-list li {
        display: grid;
        grid-template-columns: 110px 1fr;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid #1a1a1a;
    }
    .now-label {
        color: #888;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        padding-top: 0.15rem;
    }
    .now-value { color: #ddd; line-height: 1.6; }

    .journey { max-width: 780px; }
    .journey p { line-height: 1.7; color: #ccc; margin-bottom: 1rem; }
    .learning { max-width: 780px; }
    .learn { line-height: 1.75; color: #ccc; }
    .now-value a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(217,163,62,0.35); }

    .principles-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.5rem;
        max-width: 780px;
    }
    .principles-list li {
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.03);
        border-left: 2px solid #3a5;
        color: #ddd;
        line-height: 1.55;
    }

    .skills-key {
        color: #aaa;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
    }
    .skills-key strong { color: #eee; font-weight: 500; }
    .dot-sep {
        width: 3px;
        height: 3px;
        background: #444;
        border-radius: 50%;
        margin: 0 0.25rem;
    }
    .tier-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-right: 0.35rem;
    }
    .tier-dot.tier-core { background: #3a5; }
    .tier-dot.tier-working { background: #5a7fbf; }
    .tier-dot.tier-exploring { background: #8a6ec0; }

    .skill-groups {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }
    .skill-group {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid #1f1f1f;
        border-radius: 10px;
        padding: 1.25rem;
    }
    .skill-group h3 { font-size: 1.1rem; margin: 0 0 0.25rem; }
    .skill-group .blurb { color: #888; font-size: 0.85rem; margin-bottom: 1rem; line-height: 1.5; }
    .skill-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .skill-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        font-size: 0.8rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.04);
        color: #ddd;
    }
    .skill-pill .pill-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 0.4rem;
    }
    .skill-pill.tier-core .pill-dot { background: #3a5; }
    .skill-pill.tier-working .pill-dot { background: #5a7fbf; }
    .skill-pill.tier-exploring .pill-dot { background: #8a6ec0; }
    .skill-pill.tier-core { border-color: rgba(58, 170, 85, 0.3); }
    .skill-pill.tier-working { border-color: rgba(90, 127, 191, 0.3); }
    .skill-pill.tier-exploring { border-color: rgba(138, 110, 192, 0.3); }
</style>
