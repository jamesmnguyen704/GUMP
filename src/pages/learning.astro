---
import Layout from '../layouts/Layout.astro';
import TutorialCard from '../components/TutorialCard.astro';

type Status = "Completed" | "In Progress" | "Planned";

type Credential = {
    title: string;
    provider: string;
    status: Status;
    completion: string;
    description: string;
    skills: string[];
    credentialUrl?: string;
};

type Difficulty = "Beginner" | "Intermediate" | "Advanced";
type TutorialStatus = "Published" | "Draft" | "Coming Soon";

type Tutorial = {
    title: string;
    description: string;
    slug: string;
    category: string;
    difficulty: Difficulty;
    readTime: string;
    stack: string[];
    outcome: string;
    date?: string;
    status?: TutorialStatus;
    withClaude?: boolean;
    featured?: boolean;
};

// --- Tutorial series (the premium showcase) ---
const claudeTutorials: Tutorial[] = [
    {
        title: "Multi-Agent Orchestration with Claude Code",
        description: "A hub-and-spoke setup with reusable skills, tiered model routing, and a three-stage code-quality pipeline.",
        slug: "multi-agent-orchestration-claude-code",
        category: "AI · Claude",
        difficulty: "Advanced",
        readTime: "18 min read",
        stack: ["Claude Code", "Anthropic SDK", "MCP", "Ollama"],
        outcome: "A working multi-agent system with implement → review → resolve pipeline",
        status: "Draft",
        withClaude: true,
        featured: true,
    },
    {
        title: "Building a Bank Reconciliation Engine with Fuzzy Matching",
        description: "Progressive match tiers, confidence scoring, and a review queue that only surfaces what a human needs to look at.",
        slug: "bank-reconciliation-fuzzy-matching",
        category: "Automation · Finance",
        difficulty: "Advanced",
        readTime: "15 min read",
        stack: ["Python", "pandas", "rapidfuzz"],
        outcome: "A multi-tier fuzzy match engine with audit logs",
        status: "Draft",
        withClaude: true,
        featured: true,
    },
    {
        title: "Automating QuickBooks IIF Generation with Python",
        description: "How I eliminated 90%+ of manual QB entry with programmatic IIF files — and the anti-duplicate checks that make it safe.",
        slug: "quickbooks-iif-automation",
        category: "Automation · Finance",
        difficulty: "Intermediate",
        readTime: "12 min read",
        stack: ["Python", "pandas", "QuickBooks Enterprise"],
        outcome: "A CLI that generates valid IIF files with de-duplication",
        status: "Draft",
        withClaude: true,
    },
    {
        title: "ERP Data Migration: A SQL + Excel Playbook",
        description: "Extract-validate-compare workflows for an in-flight ERP migration — when you don't own the ETL.",
        slug: "erp-data-migration-sql",
        category: "Data · SQL",
        difficulty: "Intermediate",
        readTime: "10 min read",
        stack: ["SQL", "Excel", "VS Code"],
        outcome: "A repeatable reconciliation playbook and discrepancy report",
        status: "Draft",
    },
    {
        title: "Scaffolding a Full-Stack App with Claude Code",
        description: "Going from empty repo to a running Node/Express/MongoDB app — the path I took for my SavvyCoders capstone.",
        slug: "scaffolding-fullstack-with-claude",
        category: "Web · Claude",
        difficulty: "Beginner",
        readTime: "10 min read",
        stack: ["Node.js", "Express", "MongoDB", "Claude Code"],
        outcome: "A deploy-ready full-stack scaffold and your first CRUD route",
        status: "Draft",
        withClaude: true,
    },
];

const legacyTutorials: Tutorial[] = [
    {
        title: "Excel Formulas for Data Migration Validation",
        description: "Advanced Excel for validating migrations — XLOOKUP, IF chains, INDEX/MATCH, and date validation.",
        slug: "excel-formulas-tutorial",
        category: "Data · Excel",
        difficulty: "Intermediate",
        readTime: "6 min read",
        stack: ["Excel", "XLOOKUP", "INDEX/MATCH"],
        outcome: "A validation-ready Excel workflow for ERP migrations",
        date: "Apr 2025",
        status: "Published",
    },
    {
        title: "Updating My Site with Bolt, VS Code, and GitHub",
        description: "My workflow for editing this site across Bolt, VS Code, and GitHub — with clean version control.",
        slug: "updating-bolt-vscode-github",
        category: "Web · Dev Tools",
        difficulty: "Beginner",
        readTime: "8 min read",
        stack: ["Bolt", "VS Code", "GitHub"],
        outcome: "A clean edit-test-commit-deploy loop for a personal site",
        date: "Apr 2025",
        status: "Published",
    },
    {
        title: "Git Basics: Cloning a Repo and Pushing to GitHub",
        description: "The essential Git commands for cloning and pushing, with step-by-step examples.",
        slug: "git-basics-tutorial",
        category: "Dev Tools · Git",
        difficulty: "Beginner",
        readTime: "5 min read",
        stack: ["Git", "GitHub"],
        outcome: "Confidence cloning repos and pushing your first commit",
        date: "Apr 2025",
        status: "Published",
    },
];

// --- Credentials ---
const certifications: Credential[] = [
    {
        title: "Full Stack Web Development Certificate",
        provider: "Savvy Coders",
        status: "Completed",
        completion: "Dec 2025",
        description: "12-week immersive full-stack bootcamp in a facilitated Scrum environment running two-week sprints. Built and deployed the Cinemetrics capstone to Netlify/Render.",
        skills: ["JavaScript", "HTML", "CSS", "Node.js", "Express", "MongoDB", "REST APIs", "Git/GitHub", "Agile / Scrum"],
    },
    {
        title: "Data Science Certification",
        provider: "TripleTen",
        status: "Completed",
        completion: "May 2024",
        description: "16 end-to-end data science projects covering Python, EDA, statistical testing, classical ML, tree ensembles, NLP, time series, and a CNN regression.",
        skills: ["Python", "pandas", "scikit-learn", "LightGBM", "XGBoost", "TensorFlow", "NLP", "Time Series"],
    },
    {
        title: "WorkKeys Silver — National Career Readiness",
        provider: "ACT",
        status: "Completed",
        completion: "Dec 2025",
        description: "National Career Readiness Certificate at the Silver level.",
        skills: ["Data Analysis", "Applied Math", "Workplace Documents"],
    },
    {
        title: "Agile Fundamentals (ICP)",
        provider: "ICAgile",
        status: "Completed",
        completion: "2024",
        description: "ICAgile Agile Fundamentals certification.",
        skills: ["Agile", "Scrum", "Iterative Delivery"],
    },
    {
        title: "Bachelor's Degree in Accounting",
        provider: "Belmont Abbey College",
        status: "Completed",
        completion: "2012",
        description: "Financial accounting, managerial accounting, auditing, taxation, and business law.",
        skills: ["Financial Accounting", "Auditing", "Taxation", "Business Law"],
    },
];
---

<Layout title="Learning" description="Tutorial series and credentials from James Nguyen — real systems, real certifications. Built with Claude.">
    <section class="learning-header">
        <h1>Learning</h1>
        <p>
            Tutorials pulled straight from what I've shipped, plus the credentials that got me here.
            Every guide is a walkthrough of a real system — no theory, no fluff.
        </p>
    </section>

    <section class="tutorials-showcase">
        <div class="showcase-head">
            <div>
                <span class="showcase-eyebrow">Tutorial series</span>
                <h2>Built with Claude</h2>
                <p class="showcase-sub">
                    Guides from real systems I've built — finance automation, AI orchestration,
                    full-stack scaffolding. Each one walks through the actual path, with prompts
                    and code. Drafts in active writing; more landing soon.
                </p>
            </div>
            <div class="showcase-stats">
                <div class="stat">
                    <span class="stat-value">{claudeTutorials.length}</span>
                    <span class="stat-label">Built-with-Claude guides</span>
                </div>
                <div class="stat">
                    <span class="stat-value">{claudeTutorials.length + legacyTutorials.length}</span>
                    <span class="stat-label">Total tutorials</span>
                </div>
            </div>
        </div>

        <div class="tutorial-grid">
            {claudeTutorials.map(t => <TutorialCard {...t} />)}
        </div>
    </section>

    <section class="tutorials-other">
        <h2>Other guides</h2>
        <div class="tutorial-grid">
            {legacyTutorials.map(t => <TutorialCard {...t} />)}
        </div>
    </section>

    <section class="credentials">
        <div class="credentials-head">
            <h2>Credentials &amp; coursework</h2>
            <p>Where the formal learning lives.</p>
        </div>
        <div class="credentials-grid">
            {certifications.map(course => (
                <article class="course-card">
                    <div class="course-header">
                        <h3>{course.title}</h3>
                        <span class="status status-completed">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                            </svg>
                            Completed
                        </span>
                    </div>
                    <div class="provider-info">
                        <span class="provider">{course.provider}</span>
                        <span class="completion">{course.completion}</span>
                    </div>
                    <p class="description">{course.description}</p>
                    <div class="skills">
                        {course.skills.map(skill => <span class="skill-tag">{skill}</span>)}
                    </div>
                </article>
            ))}
        </div>
    </section>
</Layout>

<style>
    .learning-header { margin: 4rem 0 2rem; max-width: 780px; }
    .learning-header h1 { font-size: 3rem; margin-bottom: 1rem; }
    .learning-header p { color: #ccc; font-size: 1.1rem; line-height: 1.7; }

    .tutorials-showcase {
        margin: 3rem 0 4rem;
        padding: 2rem;
        border: 1px solid rgba(217, 163, 62, 0.15);
        border-radius: 16px;
        background:
            radial-gradient(circle at top left, rgba(217, 163, 62, 0.06), transparent 50%),
            radial-gradient(circle at bottom right, rgba(90, 127, 191, 0.05), transparent 50%),
            #0a0a0a;
    }
    .showcase-head {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2rem;
        margin-bottom: 2rem;
        align-items: start;
    }
    .showcase-eyebrow {
        display: inline-block;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #d9a33e;
        margin-bottom: 0.5rem;
    }
    .showcase-head h2 {
        font-size: 2rem;
        margin: 0 0 0.75rem;
        letter-spacing: -0.01em;
    }
    .showcase-sub {
        color: #bbb;
        line-height: 1.65;
        max-width: 640px;
        margin: 0;
    }
    .showcase-stats {
        display: flex;
        gap: 1.5rem;
    }
    .stat {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        text-align: right;
    }
    .stat-value {
        font-size: 2rem;
        font-weight: 600;
        color: #d9a33e;
        line-height: 1;
    }
    .stat-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #888;
        margin-top: 0.3rem;
    }

    .tutorial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.25rem;
    }

    .tutorials-other { margin: 4rem 0; }
    .tutorials-other h2 {
        font-size: 1.4rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #222;
    }

    .credentials { margin: 4rem 0; }
    .credentials-head {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #222;
    }
    .credentials-head h2 {
        font-size: 1.4rem;
        margin: 0;
    }
    .credentials-head p {
        color: #888;
        font-size: 0.9rem;
        margin: 0;
    }
    .credentials-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1rem;
    }
    .course-card {
        background: rgba(255, 255, 255, 0.03);
        padding: 1.25rem;
        border-radius: 10px;
        border: 1px solid #1f1f1f;
    }
    .course-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.75rem;
        gap: 0.75rem;
    }
    .course-header h3 { font-size: 1.05rem; margin: 0; line-height: 1.35; }
    .status {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        flex-shrink: 0;
    }
    .status-completed {
        background: rgba(58, 170, 85, 0.1);
        color: #7fc995;
        border: 1px solid rgba(58, 170, 85, 0.25);
    }
    .provider-info {
        display: flex;
        justify-content: space-between;
        color: #888;
        margin-bottom: 0.75rem;
        font-size: 0.85rem;
    }
    .description { margin-bottom: 1rem; line-height: 1.55; color: #bbb; font-size: 0.9rem; }
    .skills { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .skill-tag {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.15rem 0.55rem;
        border-radius: 10px;
        font-size: 0.72rem;
        color: #bbb;
    }

    @media (max-width: 640px) {
        .showcase-head { grid-template-columns: 1fr; }
        .showcase-stats { justify-content: flex-start; }
        .stat { align-items: flex-start; text-align: left; }
    }
</style>
