---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SocialIcons from '../components/SocialIcons.astro';

type Status = "In production" | "Evolving";

const pillars = [
    { title: "Finance automation", body: "Accounting imports, reconciliation, and close support that validate before they act and stop when the evidence is weak." },
    { title: "Data pipelines", body: "Messy exports from accounting, banking, and project systems turned into one governed, queryable layer with clear ownership." },
    { title: "AI workflows", body: "Claude Code agents, MCP tools, and local models, run with explicit handoffs, recorded decisions, and evidence checks." },
];

const workSystems: Array<{ title: string; description: string; stack: string; status: Status }> = [
    {
        title: "Operations data platform",
        description: "Consolidates accounting, banking, project, and procurement data into normalized tables, exception queues, and generated reports, with a strict source-of-truth hierarchy so reports never compete with the books.",
        stack: "Python · SQLite · pandas · openpyxl",
        status: "In production",
    },
    {
        title: "QuickBooks import automation",
        description: "Generates import files instead of hand-keying transactions. Checks for duplicates, enforces field limits, validates sources, and fails closed. A person always does the final import.",
        stack: "Python · QuickBooks Enterprise · IIF",
        status: "In production",
    },
    {
        title: "Reconciliation engine",
        description: "Matches bank activity to accounting and project records with normalized identifiers and confidence scoring. Unmatched and ambiguous items go to a review queue instead of being forced.",
        stack: "Python · pandas · rule-based matching",
        status: "In production",
    },
    {
        title: "Operations hub",
        description: "One regenerating reporting page for finance, project, bank, and procurement status, replacing a set of disconnected dashboards.",
        stack: "Python · HTML · scheduled pipeline",
        status: "In production",
    },
    {
        title: "Document intelligence",
        description: "Reads incoming PDFs, uses OCR only when there's no usable text, extracts structured fields into a review step, and fails loudly instead of treating an unreadable file as blank.",
        stack: "Python · PDF text extraction · OCR",
        status: "In production",
    },
    {
        title: "AI agent workflow layer",
        description: "Specialized Claude Code agents with task handoffs, recorded decisions, verification rules, and automated tests around the parts that touch money.",
        stack: "Claude Code · MCP · Python · pytest",
        status: "Evolving",
    },
];

const featuredProjects = [
    {
        title: "Atlas",
        associated: "Personal data lakehouse",
        tagline: "Local-first pipeline that turns scattered personal exports into canonical, searchable data, with generated views for each AI tool. Nothing leaves my machine.",
        stack: "Python · SQLite FTS5 · Markdown · local LLMs",
        href: "/projects#atlas",
        linkLabel: "Read more",
    },
    {
        title: "No-Whey",
        associated: "Live app",
        tagline: "Dairy-ingredient checker that answers SAFE, UNSAFE, or REVIEW REQUIRED, and explains why. Catches casein hiding in \"non-dairy\" products.",
        stack: "FastAPI · JavaScript PWA · YAML rules",
        href: "https://no-whey.onrender.com",
        linkLabel: "Try it",
    },
    {
        title: "Cinemetrics",
        associated: "Live app · still maintained",
        tagline: "Movie, TV, and gaming discovery app built from scratch: vanilla JS with a hand-rolled component layer and an Express API.",
        stack: "JavaScript · Node · Express · MongoDB · TMDB",
        href: "https://capstonesavvycoders.netlify.app/",
        linkLabel: "View live",
    },
];

const latestLessons = (await getCollection('lessons'))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 4);

const description = "James Nguyen: Finance & Operations Analyst and internal developer. I build reliable data pipelines, finance automation, and AI workflows for messy real-world operations.";
---

<Layout title="Home" description={description}>
    <section class="hero">
        <p class="eyebrow">Finance &amp; Operations Analyst · Internal Developer</p>
        <h1>I build the systems finance and operations run on.</h1>
        <p class="description">
            I'm James. I spent ten years in accounting and reconciliation, then learned data science and
            full-stack development. Now I build the internal tools a commercial solar and energy-storage
            contractor runs its back office on: data pipelines, QuickBooks automation, reconciliation,
            and AI agent workflows. I write down what breaks along the way.
        </p>
        <div class="hero-cta">
            <a href="/projects" class="cta-primary">See the work <span aria-hidden="true">&rarr;</span></a>
            <a href="/blog" class="cta-secondary">Read the lessons</a>
            <a href="/work" class="cta-secondary">Experience</a>
        </div>
        <div class="hero-social">
            <SocialIcons size="sm" />
        </div>
    </section>

    <section class="pillars">
        <ul class="pillar-grid">
            {pillars.map(p => (
                <li class="pillar">
                    <h3>{p.title}</h3>
                    <p>{p.body}</p>
                </li>
            ))}
        </ul>
    </section>

    <section class="building">
        <div class="section-head">
            <h2>What I've built at work</h2>
            <p class="section-sub">
                Internal systems at Day &amp; Night Solar, where I'm the sole developer. The code is private,
                so these describe what each system does, not company data.
            </p>
        </div>
        <ul class="systems-grid">
            {workSystems.map(system => (
                <li class="system-card">
                    <div class="system-top">
                        <h3>{system.title}</h3>
                        <span class={`status-chip status-${system.status.toLowerCase().replace(/\s+/g, "-")}`}>
                            <span class="status-dot" aria-hidden="true"></span>
                            {system.status}
                        </span>
                    </div>
                    <p>{system.description}</p>
                    <p class="stack">{system.stack}</p>
                </li>
            ))}
        </ul>
    </section>

    <section class="featured">
        <div class="section-head">
            <h2>Personal projects</h2>
            <a href="/projects" class="inline-link">All projects <span aria-hidden="true">&rarr;</span></a>
        </div>
        <ul class="featured-grid">
            {featuredProjects.map(p => (
                <li class="featured-card">
                    <span class="associated">{p.associated}</span>
                    <h3>{p.title}</h3>
                    <p class="tagline">{p.tagline}</p>
                    <p class="stack">{p.stack}</p>
                    {p.href.startsWith("http") ? (
                        <a href={p.href} target="_blank" rel="noopener noreferrer" class="live-link">
                            {p.linkLabel} <span aria-hidden="true">&rarr;</span>
                        </a>
                    ) : (
                        <a href={p.href} class="live-link">
                            {p.linkLabel} <span aria-hidden="true">&rarr;</span>
                        </a>
                    )}
                </li>
            ))}
        </ul>
    </section>

    <section class="lessons">
        <div class="section-head">
            <h2>Latest lessons</h2>
            <a href="/blog#lessons" class="inline-link">All lessons <span aria-hidden="true">&rarr;</span></a>
        </div>
        <ul class="lesson-list">
            {latestLessons.map(l => (
                <li>
                    <a href={`/lessons/${l.slug}`} class="lesson-row">
                        <span class="lesson-title">{l.data.title}</span>
                        <span class="lesson-rule">{l.data.rule}</span>
                    </a>
                </li>
            ))}
        </ul>
    </section>

    <section class="contact">
        <h2>Let's talk</h2>
        <p>
            I'm open to full-time roles where accounting, data, and code meet: finance systems,
            analytics engineering, data and automation engineering, and internal tools.
        </p>
        <SocialIcons size="md" />
    </section>
</Layout>

<style>
    .hero {
        margin: 3rem 0 4rem;
        max-width: 820px;
    }
    .eyebrow {
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.72rem;
        margin-bottom: 1.25rem;
    }
    .hero h1 {
        font-size: clamp(2.25rem, 5vw, 3.6rem);
        line-height: 1.08;
        margin-bottom: 1.5rem;
        letter-spacing: -0.03em;
        font-weight: 700;
    }
    .description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #bbb;
        max-width: 720px;
        margin-bottom: 2rem;
    }
    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 2rem;
    }
    .cta-primary,
    .cta-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.65rem 1.15rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.92rem;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .cta-primary { background: #fff; color: #000; border: 1px solid #fff; }
    .cta-primary:hover { background: #ddd; border-color: #ddd; }
    .cta-secondary { color: #eee; border: 1px solid #2a2a2a; }
    .cta-secondary:hover { border-color: #fff; }
    .hero-social { margin-top: 0.25rem; }

    section { margin: 3.5rem 0; }
    .section-head { margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
    .section-head h2 { font-size: 1.5rem; margin: 0; letter-spacing: -0.01em; }
    .section-sub {
        color: #888;
        font-size: 0.95rem;
        max-width: 680px;
        line-height: 1.55;
        margin: 0.35rem 0 0;
        flex-basis: 100%;
    }
    .inline-link { color: #aaa; text-decoration: none; font-size: 0.88rem; transition: color 0.15s; }
    .inline-link:hover { color: #fff; }

    .pillars { margin: 2.5rem 0 3rem; }
    .pillar-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
    }
    .pillar {
        padding: 1.25rem;
        border: 1px solid #1f1f1f;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.02);
    }
    .pillar h3 { font-size: 1rem; margin: 0 0 0.5rem; color: #eee; }
    .pillar p { color: #999; font-size: 0.88rem; line-height: 1.55; }

    .systems-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
    }
    .system-card {
        background: #0d0d0d;
        border: 1px solid #1f1f1f;
        border-radius: 10px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .system-top { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
    .system-top h3 { font-size: 1rem; margin: 0; color: #eee; }
    .status-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 500;
        border: 1px solid transparent;
        white-space: nowrap;
    }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-in-production { color: #a5bae8; border-color: rgba(90, 127, 191, 0.3); background: rgba(90, 127, 191, 0.08); }
    .status-in-production .status-dot { background: #5a7fbf; }
    .status-evolving { color: #d9a33e; border-color: rgba(217, 163, 62, 0.3); background: rgba(217, 163, 62, 0.08); }
    .status-evolving .status-dot { background: #d9a33e; }
    .system-card p { color: #bbb; line-height: 1.55; font-size: 0.88rem; }
    .system-card .stack { color: #666; font-size: 0.76rem; margin-top: auto; padding-top: 0.25rem; }

    .featured-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
    }
    .featured-card {
        border: 1px solid #2a2a2a;
        border-radius: 10px;
        padding: 1.25rem;
        background: #111;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .featured-card .associated { color: #888; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
    .featured-card h3 { font-size: 1.05rem; margin: 0; color: #eee; }
    .featured-card .tagline { color: #bbb; line-height: 1.5; font-size: 0.88rem; }
    .featured-card .stack { color: #666; font-size: 0.76rem; margin-top: 0.25rem; }
    .featured-card .live-link {
        color: #eee;
        text-decoration: none;
        font-size: 0.85rem;
        margin-top: auto;
        padding-top: 0.5rem;
    }
    .featured-card .live-link:hover { color: var(--accent); }

    .lesson-list { list-style: none; border-top: 1px solid #1a1a1a; }
    .lesson-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
        gap: 0.4rem 2rem;
        padding: 1rem 0.25rem;
        border-bottom: 1px solid #1a1a1a;
        text-decoration: none;
        transition: background 0.15s;
    }
    .lesson-row:hover { background: rgba(255, 255, 255, 0.025); }
    .lesson-title { color: #eee; font-weight: 600; line-height: 1.4; }
    .lesson-rule { color: #999; font-size: 0.9rem; line-height: 1.5; }

    .contact h2 { font-size: 1.4rem; margin-bottom: 0.5rem; }
    .contact p { color: #bbb; line-height: 1.65; margin-bottom: 1.25rem; max-width: 720px; font-size: 0.95rem; }

    @media (max-width: 640px) {
        .lesson-row { grid-template-columns: 1fr; }
        .systems-grid, .featured-grid { grid-template-columns: 1fr; }
    }
</style>
