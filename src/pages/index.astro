---
import Layout from '../layouts/Layout.astro';
import SocialIcons from '../components/SocialIcons.astro';

type Status = "Live" | "In Production" | "In Dev";

const pillars = [
    { title: "Automate finance operations", body: "QuickBooks IIF generation, bank reconciliation engines, AR/AP pipelines — replacing manual work with safe, auditable automation." },
    { title: "Engineer data platforms", body: "FastAPI + SQLAlchemy services, Postgres-ready schemas, ETL from SAGE/CMiC/QuickBooks into something you can actually query." },
    { title: "Orchestrate AI workflows", body: "Multi-agent Claude Code setups, tiered cloud + local LLM routing, OCR + classification for document intelligence." },
];

const currentlyBuilding: Array<{ title: string; description: string; stack: string; status: Status; outcome?: string }> = [
    {
        title: "Finance Platform",
        description: "Python/FastAPI + SQLAlchemy service layer designed for Postgres migration. Replaces a spreadsheet-centric close process with a query-able operational database.",
        stack: "FastAPI · SQLAlchemy · Alembic · Postgres",
        status: "In Dev",
    },
    {
        title: "QuickBooks Automation",
        description: "Programmatic IIF generation for customers, POs, invoices, and deposits — with anti-duplicate safety checks against tens of thousands of historical transactions.",
        stack: "Python · QuickBooks Enterprise · IIF",
        status: "In Production",
        outcome: "90%+ of manual QB entry eliminated",
    },
    {
        title: "Bank Reconciliation Engine",
        description: "Progressive fuzzy-match engine across 5 bank accounts. Tier-priority confidence scoring with review queues for ambiguous matches — surfaces discrepancies before month-end.",
        stack: "Python · pandas · rule-based matching",
        status: "In Production",
    },
    {
        title: "Executive Dashboards",
        description: "pandas + openpyxl pipeline covering P&L, cash flow, billing, margin, and schedule. Auto-regenerates — CFO reads the same data leadership does.",
        stack: "pandas · openpyxl · HTML",
        status: "Live",
    },
    {
        title: "AI Orchestration Layer",
        description: "Multi-agent framework on Claude Code — reusable skill definitions, a three-stage code-quality pipeline (implement → review → resolve), tiered model routing.",
        stack: "Claude Code · Anthropic SDK · MCP · Ollama",
        status: "In Dev",
    },
    {
        title: "Document Intelligence",
        description: "OCR + classification + auto-routing for hundreds of incoming vendor docs, bank statements, and internal cost models.",
        stack: "EasyOCR · PyPDF2 · Python",
        status: "In Production",
    },
];

const featuredProjects = [
    {
        title: "Cinemetrics",
        associated: "SavvyCoders Capstone",
        tagline: "Full-stack SPA — real-time movie data from the TMDB API.",
        stack: "JavaScript · Node · Express · MongoDB",
        liveUrl: "https://capstonesavvycoders.netlify.app/",
    },
    {
        title: "No-Whey",
        associated: "Personal Project",
        tagline: "Dairy-free ingredient checker PWA — with flashlight, confetti, and install.",
        stack: "PWA · JavaScript · REST API",
        liveUrl: "https://no-whey.onrender.com",
    },
    {
        title: "Age Detection",
        associated: "TripleTen Program",
        tagline: "Computer-vision regression for alcohol-sales compliance.",
        stack: "Python · TensorFlow · Keras · CNN",
    },
];

const description = "Data & AI engineer from a 10+ year finance background. I turn messy operations into intelligent systems — reconciliation, automation, and AI-integrated back-office tooling.";
---

<Layout title="Home" description={description}>
    <section class="hero">
        <p class="eyebrow">Data &amp; AI Engineer · Finance &amp; Operations Analyst</p>
        <h1>Turning messy operations<br/>into intelligent systems.</h1>
        <p class="description">
            I'm James — ten years in accounting, a TripleTen Data Science certification, and a
            SavvyCoders Full Stack certificate. These days I build internal operating systems where
            finance, data engineering, and AI orchestration meet. Currently rebuilding back-office
            ops at Day &amp; Night Solar across 170+ commercial projects in 15 states.
        </p>
        <div class="hero-cta">
            <a href="/work" class="cta-primary">See the work <span aria-hidden="true">&rarr;</span></a>
            <a href="/projects" class="cta-secondary">Projects</a>
            <a href="/blog" class="cta-secondary">Writing</a>
        </div>
        <div class="hero-social">
            <SocialIcons size="sm" />
        </div>
    </section>

    <section class="pillars">
        <ul class="pillar-grid">
            {pillars.map(p => (
                <li class="pillar">
                    <h3>{p.title}</h3>
                    <p>{p.body}</p>
                </li>
            ))}
        </ul>
    </section>

    <section class="building">
        <div class="section-head">
            <h2>Currently building</h2>
            <p class="section-sub">
                Six systems that make up the internal operations platform at Day &amp; Night Solar.
                Each one replaces a spreadsheet, a folder of PDFs, or a manual QuickBooks workflow.
            </p>
        </div>
        <ul class="systems-grid">
            {currentlyBuilding.map(system => (
                <li class="system-card">
                    <div class="system-top">
                        <h3>{system.title}</h3>
                        <span class={`status-chip status-${system.status.toLowerCase().replace(/\s+/g, "-")}`}>
                            <span class="status-dot" aria-hidden="true"></span>
                            {system.status}
                        </span>
                    </div>
                    <p>{system.description}</p>
                    {system.outcome && <p class="outcome">{system.outcome}</p>}
                    <p class="stack">{system.stack}</p>
                </li>
            ))}
        </ul>
    </section>

    <section class="featured">
        <div class="section-head">
            <h2>Featured projects</h2>
            <a href="/projects" class="inline-link">See all projects <span aria-hidden="true">&rarr;</span></a>
        </div>
        <ul class="featured-grid">
            {featuredProjects.map(p => (
                <li class="featured-card">
                    {p.associated && <span class="associated">{p.associated}</span>}
                    <h3>{p.title}</h3>
                    <p class="tagline">{p.tagline}</p>
                    <p class="stack">{p.stack}</p>
                    {p.liveUrl && (
                        <a href={p.liveUrl} target="_blank" rel="noopener noreferrer" class="live-link">
                            View live <span aria-hidden="true">&rarr;</span>
                        </a>
                    )}
                </li>
            ))}
        </ul>
    </section>

    <section class="contact">
        <h2>Let's connect</h2>
        <p>
            Open to Data Analyst, Analytics Engineer, Junior Software Engineer, and Finance/Operations
            roles where accounting, data, and code intersect.
        </p>
        <SocialIcons size="md" />
    </section>
</Layout>

<style>
    .hero {
        margin: 3rem 0 4rem;
        max-width: 820px;
    }
    .eyebrow {
        color: #d9a33e;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.72rem;
        margin-bottom: 1.25rem;
    }
    .hero h1 {
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        line-height: 1.08;
        margin-bottom: 1.5rem;
        letter-spacing: -0.03em;
        font-weight: 700;
    }
    .description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #bbb;
        max-width: 720px;
        margin-bottom: 2rem;
    }
    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 2rem;
    }
    .cta-primary,
    .cta-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.65rem 1.15rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.92rem;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .cta-primary {
        background: #fff;
        color: #000;
        border: 1px solid #fff;
    }
    .cta-primary:hover { background: #ddd; border-color: #ddd; }
    .cta-secondary {
        color: #eee;
        border: 1px solid #2a2a2a;
    }
    .cta-secondary:hover { border-color: #fff; }
    .hero-social { margin-top: 0.25rem; }

    section { margin: 3rem 0; }
    .section-head { margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
    .section-head h2 {
        font-size: 1.5rem;
        margin: 0;
        letter-spacing: -0.01em;
    }
    .section-sub {
        color: #888;
        font-size: 0.95rem;
        max-width: 680px;
        line-height: 1.55;
        margin: 0.35rem 0 0;
        flex-basis: 100%;
    }
    .inline-link {
        color: #aaa;
        text-decoration: none;
        font-size: 0.88rem;
        transition: color 0.15s;
    }
    .inline-link:hover { color: #fff; }

    .pillars { margin: 2.5rem 0 3rem; }
    .pillar-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
    }
    .pillar {
        padding: 1.25rem;
        border: 1px solid #1f1f1f;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.02);
    }
    .pillar h3 {
        font-size: 1rem;
        margin: 0 0 0.5rem;
        color: #eee;
    }
    .pillar p {
        color: #999;
        font-size: 0.88rem;
        line-height: 1.55;
        margin: 0;
    }

    .systems-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
    }
    .system-card {
        background: #0d0d0d;
        border: 1px solid #1f1f1f;
        border-radius: 10px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .system-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
    }
    .system-top h3 {
        font-size: 1rem;
        margin: 0;
        color: #eee;
    }
    .status-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-weight: 500;
        border: 1px solid transparent;
        white-space: nowrap;
    }
    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }
    .status-live { color: #7fc995; border-color: rgba(58, 170, 85, 0.3); background: rgba(58, 170, 85, 0.08); }
    .status-live .status-dot { background: #3a5; box-shadow: 0 0 6px rgba(58, 170, 85, 0.6); }
    .status-in-production { color: #a5bae8; border-color: rgba(90, 127, 191, 0.3); background: rgba(90, 127, 191, 0.08); }
    .status-in-production .status-dot { background: #5a7fbf; }
    .status-in-dev { color: #d9a33e; border-color: rgba(217, 163, 62, 0.3); background: rgba(217, 163, 62, 0.08); }
    .status-in-dev .status-dot { background: #d9a33e; }

    .system-card p { color: #bbb; line-height: 1.5; font-size: 0.88rem; margin: 0; }
    .system-card .outcome { color: #7fc995; font-size: 0.8rem; font-weight: 500; }
    .system-card .stack { color: #666; font-size: 0.76rem; margin-top: auto; padding-top: 0.25rem; }

    .featured-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
    }
    .featured-card {
        border: 1px solid #2a2a2a;
        border-radius: 10px;
        padding: 1.25rem;
        background: #111;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .featured-card .associated {
        color: #888;
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
    .featured-card h3 { font-size: 1.05rem; margin: 0; color: #eee; }
    .featured-card .tagline { color: #bbb; line-height: 1.5; font-size: 0.88rem; margin: 0; }
    .featured-card .stack { color: #666; font-size: 0.76rem; margin-top: 0.25rem; }
    .featured-card .live-link {
        color: #eee;
        text-decoration: none;
        font-size: 0.85rem;
        margin-top: auto;
        padding-top: 0.5rem;
    }
    .featured-card .live-link:hover { color: #fff; }

    .contact h2 { font-size: 1.4rem; margin-bottom: 0.5rem; }
    .contact p { color: #bbb; line-height: 1.65; margin-bottom: 1.25rem; max-width: 720px; font-size: 0.95rem; }
</style>
