---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TutorialCard from '../components/TutorialCard.astro';
import BlogPost from '../components/BlogPost.astro';

type Difficulty = "Beginner" | "Intermediate" | "Advanced";
type TutorialStatus = "Published" | "Draft" | "Coming Soon";

type Tutorial = {
    title: string;
    description: string;
    slug: string;
    category: string;
    difficulty: Difficulty;
    readTime: string;
    stack: string[];
    outcome: string;
    date?: string;
    status?: TutorialStatus;
    withClaude?: boolean;
    featured?: boolean;
};

const lessons = (await getCollection('lessons')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const workLessons = lessons.filter(l => l.data.area === 'work');
const personalLessons = lessons.filter(l => l.data.area === 'personal');
const lessonGroups = [
    {
        title: "From work",
        blurb: "Building internal finance and operations systems for a commercial solar contractor. Concepts only: no company, client, or financial data.",
        items: workLessons,
    },
    {
        title: "From personal projects",
        blurb: "My data lake, local AI lab, solar build, and side projects.",
        items: personalLessons,
    },
];

const legacyTutorials: Tutorial[] = [
    {
        title: "Excel Formulas for Data Migration Validation",
        description: "Advanced Excel for validating migrations — XLOOKUP, IF chains, INDEX/MATCH, and date validation.",
        slug: "excel-formulas-tutorial",
        category: "Data · Excel",
        difficulty: "Intermediate",
        readTime: "6 min read",
        stack: ["Excel", "XLOOKUP", "INDEX/MATCH"],
        outcome: "A validation-ready Excel workflow for ERP migrations",
        date: "Apr 2025",
        status: "Published",
    },
    {
        title: "Updating My Site with Bolt, VS Code, and GitHub",
        description: "My workflow for editing this site across Bolt, VS Code, and GitHub — with clean version control.",
        slug: "updating-bolt-vscode-github",
        category: "Web · Dev Tools",
        difficulty: "Beginner",
        readTime: "8 min read",
        stack: ["Bolt", "VS Code", "GitHub"],
        outcome: "A clean edit-test-commit-deploy loop for a personal site",
        date: "Apr 2025",
        status: "Published",
    },
    {
        title: "Git Basics: Cloning a Repo and Pushing to GitHub",
        description: "The essential Git commands for cloning and pushing, with step-by-step examples.",
        slug: "git-basics-tutorial",
        category: "Dev Tools · Git",
        difficulty: "Beginner",
        readTime: "5 min read",
        stack: ["Git", "GitHub"],
        outcome: "Confidence cloning repos and pushing your first commit",
        date: "Apr 2025",
        status: "Published",
    },
];

// --- Blog-style posts (career, updates, notes) ---
type Post = {
    title: string;
    date: string;
    readTime: string;
    category: string;
    excerpt: string;
    slug: string;
};

const posts: Post[] = [
    {
        title: "Machine Learning in Finance",
        date: "03 Dec 2023",
        readTime: "10 min read",
        category: "Machine Learning",
        excerpt: "A practical look at how ML techniques apply to financial problems — and where traditional methods still win.",
        slug: "machine-learning-in-finance",
    },
    {
        title: "Correlation and Hypothesis Testing",
        date: "Feb 2024",
        readTime: "7 min read",
        category: "Statistics",
        excerpt: "Notes on correlation measures and the hypothesis tests that go with them — from the TripleTen program.",
        slug: "correlation-hypothesis",
    },
    {
        title: "Sprint 1: Python Fundamentals Review",
        date: "20 Apr 2025",
        readTime: "12 min read",
        category: "Programming",
        excerpt: "A deep review of Sprint 1 fundamentals from the TripleTen program — data types, control flow, and early pandas.",
        slug: "sprint1-python-fundamentals",
    },
    {
        title: "Data Analyst Role in St. Louis",
        date: "2025",
        readTime: "5 min read",
        category: "Career",
        excerpt: "Notes from landing a contract data analyst role at Keeley Companies — ERP migration, SQL at scale.",
        slug: "data-analyst-role-st-louis",
    },
];

---

<Layout title="Writing" description="Lessons from building finance automation, data pipelines, and AI workflows: what broke, what I learned, and the rule I kept.">
    <section class="writing-header">
        <h1>Writing</h1>
        <p>
            Short lessons from real systems: what I was building, what broke or surprised me,
            and the rule I kept afterward. Newest first.
        </p>
    </section>

    <section class="lessons-section" id="lessons">
        <div class="section-head">
            <h2>Lessons</h2>
            <span class="count"><strong>{lessons.length}</strong> lessons</span>
        </div>
        {lessonGroups.map(group => (
            <div class="lesson-group">
                <h3 class="subhead">{group.title}</h3>
                <p class="group-blurb">{group.blurb}</p>
                <ul class="lesson-list">
                    {group.items.map(l => (
                        <li>
                            <a href={`/lessons/${l.slug}`} class="lesson-card">
                                <span class="lesson-meta">{l.data.project} · {l.data.when}</span>
                                <span class="lesson-title">{l.data.title}</span>
                                <span class="lesson-summary">{l.data.summary}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
    </section>

    <section class="tutorials-section">
        <div class="section-head">
            <h2>Guides</h2>
        </div>
        <div class="tutorial-grid">
            {legacyTutorials.map(t => <TutorialCard {...t} />)}
        </div>
    </section>

    <section class="posts-section">
        <h2>Earlier notes</h2>
        <p class="section-sub">From the TripleTen data science program and my first data analyst role.</p>
        {posts.map(post => <BlogPost {...post} />)}
    </section>
</Layout>

<style>
    .writing-header { margin: 3rem 0 2rem; max-width: 780px; }
    .writing-header h1 { font-size: 3rem; margin-bottom: 1rem; letter-spacing: -0.02em; }
    .writing-header p { color: #bbb; font-size: 1.1rem; line-height: 1.7; }

    .lessons-section { margin: 3rem 0 4rem; scroll-margin-top: 6rem; }
    .tutorials-section { margin: 4rem 0; }
    .posts-section { margin: 4rem 0; }

    .section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid #222;
    }
    .section-head h2 { font-size: 1.6rem; margin: 0; }
    .count { color: #888; font-size: 0.82rem; }
    .count strong { color: #eee; }

    .subhead {
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent);
        margin: 2rem 0 0.35rem;
    }
    .group-blurb { color: #888; font-size: 0.9rem; line-height: 1.55; margin-bottom: 1rem; max-width: 720px; }

    .lesson-list {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 0.9rem;
    }
    .lesson-card {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        height: 100%;
        padding: 1.15rem 1.25rem;
        border: 1px solid #1f1f1f;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.02);
        text-decoration: none;
        transition: border-color 0.15s, background 0.15s;
    }
    .lesson-card:hover { border-color: #3a3a3a; background: rgba(255, 255, 255, 0.04); }
    .lesson-meta { color: #777; font-size: 0.74rem; }
    .lesson-title { color: #eee; font-weight: 600; font-size: 1.02rem; line-height: 1.35; }
    .lesson-summary { color: #aaa; font-size: 0.87rem; line-height: 1.55; }

    .tutorial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.1rem;
    }

    .posts-section h2 {
        font-size: 1.6rem;
        margin-bottom: 0.5rem;
        padding-bottom: 0.6rem;
        border-bottom: 1px solid #222;
    }
    .section-sub { color: #888; font-size: 0.95rem; margin-bottom: 2rem; }

    @media (max-width: 400px) {
        .lesson-list { grid-template-columns: 1fr; }
        .tutorial-grid { grid-template-columns: 1fr; }
    }
</style>
