---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const repoUrl = "https://github.com/jamesmnguyen704/TripleTenProgram";

type Project = {
    title: string;
    description: string;
    technologies: string[];
    githubUrl: string;
    outcome?: string;
    featured?: boolean;
    category:
        | "Finance & Analytics"
        | "Classification & Churn"
        | "Regression & Forecasting"
        | "NLP"
        | "Computer Vision"
        | "Exploratory Analysis"
        | "Web";
};

const projects: Project[] = [
    {
        title: "Customer Retention Prediction (Telecom)",
        description: "Predicted contract cancellations for a telecom operator so marketing could reach at-risk customers before they churned.",
        technologies: ["Python", "scikit-learn", "TensorFlow", "Random Forest", "Logistic Regression", "CNN"],
        outcome: "AUC-ROC ≥ 0.75",
        githubUrl: repoUrl,
        category: "Classification & Churn",
        featured: true,
    },
    {
        title: "Car Price Prediction",
        description: "Built a gradient-boosted model to estimate used-car market value with a focus on prediction speed as well as accuracy.",
        technologies: ["Python", "CatBoost", "LightGBM", "XGBoost", "scikit-learn"],
        outcome: "Fast, tuned gradient-boosted model beat baseline linear regression",
        githubUrl: repoUrl,
        category: "Regression & Forecasting",
        featured: true,
    },
    {
        title: "Age Estimation from Photos (CNN)",
        description: "Neural-network regression model that estimates age from a photograph — trained on a labeled image dataset.",
        technologies: ["Python", "TensorFlow / Keras", "CNN", "PIL"],
        outcome: "Regression CNN trained end-to-end on image data",
        githubUrl: repoUrl,
        category: "Computer Vision",
        featured: true,
    },
    {
        title: "Movie Review Sentiment",
        description: "Trained NLP models to automatically flag negative movie reviews for sentiment tracking.",
        technologies: ["Python", "NLTK", "spaCy", "transformers", "Logistic Regression", "LightGBM"],
        outcome: "Multi-model NLP pipeline with transformer features",
        githubUrl: repoUrl,
        category: "NLP",
    },
    {
        title: "Taxi Orders Forecasting",
        description: "Forecasted the number of taxi orders in the next hour to help optimize fleet scheduling.",
        technologies: ["Python", "statsmodels", "scikit-learn", "LightGBM"],
        outcome: "RMSE ≤ 48 on hourly forecast",
        githubUrl: repoUrl,
        category: "Regression & Forecasting",
    },
    {
        title: "Cell Phone Plan Recommender",
        description: "Classification model that picks the best cell plan for a customer based on usage patterns.",
        technologies: ["Python", "scikit-learn", "Decision Tree", "Random Forest", "Logistic Regression"],
        outcome: "Accuracy ≥ 0.75",
        githubUrl: repoUrl,
        category: "Classification & Churn",
    },
    {
        title: "Bank Client Retention",
        description: "Predicted which bank customers were likely to leave so retention campaigns could be targeted.",
        technologies: ["Python", "scikit-learn", "Random Forest", "Logistic Regression"],
        outcome: "F1 ≥ 0.59",
        githubUrl: repoUrl,
        category: "Classification & Churn",
    },
    {
        title: "Credit Scoring Analysis",
        description: "Evaluated borrower metrics to predict the likelihood of loan default, supporting lending decisions.",
        technologies: ["Python", "pandas"],
        outcome: "Identified drivers of default risk",
        githubUrl: repoUrl,
        category: "Finance & Analytics",
    },
    {
        title: "Oil Well Location Selection",
        description: "Validated reserve volume models and calculated profit/risk trade-offs across candidate drilling regions.",
        technologies: ["Python", "scikit-learn", "Linear Regression", "Bootstrap"],
        outcome: "Picked the region with the best risk-adjusted return",
        githubUrl: repoUrl,
        category: "Finance & Analytics",
    },
    {
        title: "Gold Recovery Modeling",
        description: "Modeled the gold-mining recovery process to surface efficiency improvements in the production line.",
        technologies: ["Python", "scikit-learn", "Linear Regression", "Decision Tree", "Random Forest"],
        outcome: "Prototype model for industrial use",
        githubUrl: repoUrl,
        category: "Regression & Forecasting",
    },
    {
        title: "Insurance Benefit Modeling",
        description: "Identified similar customers and predicted insurance benefit amounts while preserving data privacy.",
        technologies: ["Python", "scikit-learn", "K-Nearest Neighbors", "seaborn"],
        outcome: "Privacy-aware similarity + benefit model",
        githubUrl: repoUrl,
        category: "Classification & Churn",
    },
    {
        title: "Vehicle Price Analysis",
        description: "Investigated which features drive used-vehicle prices in classified ads — a pricing-strategy study.",
        technologies: ["Python", "pandas", "NumPy", "Matplotlib"],
        outcome: "Feature importance report for pricing",
        githubUrl: repoUrl,
        category: "Exploratory Analysis",
    },
    {
        title: "Video Game Sales Hypothesis Testing",
        description: "Tested hypotheses on user vs. critic scores to pick promising platforms and advertising directions.",
        technologies: ["Python", "pandas", "SciPy", "Matplotlib"],
        outcome: "Statistically validated platform recommendations",
        githubUrl: repoUrl,
        category: "Exploratory Analysis",
    },
    {
        title: "Taxi Trips vs. Weather",
        description: "Tested whether weather conditions meaningfully shift taxi trip duration — a hypothesis-testing study.",
        technologies: ["Python", "pandas", "SciPy"],
        outcome: "Hypothesis test on real trip data",
        githubUrl: repoUrl,
        category: "Exploratory Analysis",
    },
    {
        title: "Cell Plan Revenue Analysis",
        description: "Analyzed client behavior across telecom packages to identify which plans generate the most revenue.",
        technologies: ["Python", "pandas", "SciPy", "Matplotlib"],
        outcome: "Revenue-driver segmentation",
        githubUrl: repoUrl,
        category: "Finance & Analytics",
    },
    {
        title: "Music Preferences Across Cities",
        description: "Compared listening habits between two cities to surface patterns in music preference.",
        technologies: ["Python", "pandas"],
        outcome: "First end-to-end EDA project",
        githubUrl: repoUrl,
        category: "Exploratory Analysis",
    },
    {
        title: "jamesnguyen.netlify.app",
        description: "This site — an Astro static build deployed on Netlify. A place to write, log what I'm learning, and ship small web work.",
        technologies: ["Astro", "TypeScript", "HTML", "CSS", "Netlify"],
        githubUrl: "https://github.com/jamesmnguyen704/GUMP",
        outcome: "Shipped and live",
        category: "Web",
    },
];

const categoryOrder: Project["category"][] = [
    "Classification & Churn",
    "Regression & Forecasting",
    "NLP",
    "Computer Vision",
    "Finance & Analytics",
    "Exploratory Analysis",
    "Web",
];

const byCategory = categoryOrder
    .map(category => ({
        category,
        items: projects.filter(p => p.category === category),
    }))
    .filter(group => group.items.length > 0);

const featured = projects.filter(p => p.featured);
const description = "Machine learning, forecasting, NLP, computer vision, and financial analytics projects by James Nguyen.";
---

<Layout title="Projects" description={description}>
    <section class="projects-header">
        <h1>Projects</h1>
        <p>
            Real problems, honest write-ups. Each project shows what it was trying to solve,
            what came out of it, and the stack used to get there.
        </p>
    </section>

    {featured.length > 0 && (
        <section class="projects-section">
            <h2>Featured</h2>
            <div class="projects-grid">
                {featured.map(p => <ProjectCard {...p} />)}
            </div>
        </section>
    )}

    {byCategory.map(group => (
        <section class="projects-section">
            <h2>{group.category} <span class="count">({group.items.length})</span></h2>
            <div class="projects-grid">
                {group.items.map(p => <ProjectCard {...p} />)}
            </div>
        </section>
    ))}
</Layout>

<style>
    .projects-header {
        margin: 4rem 0 3rem;
    }
    .projects-header h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
    .projects-header p {
        color: var(--accent-color);
        font-size: 1.1rem;
        max-width: 640px;
        line-height: 1.6;
    }
    .projects-section {
        margin: 3rem 0;
    }
    .projects-section h2 {
        font-size: 1.4rem;
        margin-bottom: 1.25rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #222;
    }
    .count {
        color: var(--accent-color);
        font-size: 0.9rem;
        font-weight: normal;
    }
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.25rem;
    }
</style>
