---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const tripleTenRepo = "https://github.com/jamesmnguyen704/TripleTenProgram";
const savvyRepo = "https://github.com/jamesmnguyen704/CapstoneSavvyCoders";

// --- Work systems (Day & Night Solar). Private code, so concepts only: no company data. ---
const systems = [
    {
        title: "Operations data platform",
        associated: "Work · sole developer",
        description: "A Python + SQLite platform that consolidates accounting, banking, project, and procurement data into normalized tables, exception queues, and generated reports. A strict source-of-truth hierarchy keeps the accounting system authoritative; everything else is a derived, dated view.",
        technologies: ["Python", "SQLite", "pandas", "openpyxl", "pytest"],
        outcome: "One governed data layer instead of competing spreadsheets",
        featured: true,
    },
    {
        title: "QuickBooks import automation",
        associated: "Work",
        description: "Generates QuickBooks Enterprise import files instead of hand-keying transactions. Looks up what already exists, checks for duplicates, enforces field limits, validates sources, and fails closed. A person always performs the final import.",
        technologies: ["Python", "QuickBooks Enterprise", "IIF", "pandas"],
        outcome: "Repetitive entry replaced by validated, reviewable files",
    },
    {
        title: "Reconciliation engine",
        associated: "Work",
        description: "Matches bank activity against accounting and project records using normalized identifiers and confidence scoring. Every record lands in an explicit state (confirmed, proposed, unmatched, or needs review) instead of being forced into a match.",
        technologies: ["Python", "pandas", "rule-based matching"],
        outcome: "Surfaced an unlinked payment on its first run",
    },
    {
        title: "Operator dashboards",
        associated: "Work",
        description: "A warehouse health view, an agent-coordination dashboard, and an ownership board that shows every open item's owner and how long it's been waiting. All generated from the same pipeline, so they can't drift from each other the way one-off dashboards do.",
        technologies: ["Python", "HTML", "scheduled pipeline"],
        outcome: "One generated family of operator pages, not scattered one-offs",
    },
    {
        title: "Document intelligence",
        associated: "Work",
        description: "Reads incoming PDFs, including scanned ones. Uses OCR only when native text isn't enough, extracts structured fields into a review step, preserves existing data, and fails loudly instead of treating an unreadable file as empty.",
        technologies: ["Python", "PDF text extraction", "OCR"],
        outcome: "Document data flows into review instead of retyping",
    },
    {
        title: "AI agent workflow layer",
        associated: "Work · evolving",
        description: "Specialized Claude Code agents with task handoffs, recorded decisions, and verification rules. A release gate and a growing automated test suite check every change before it ships, not just the parts that touch money. Started bigger; I cut it down to what actually earned its coordination cost.",
        technologies: ["Claude Code", "MCP", "Python", "pytest"],
        outcome: "Fewer agents, explicit handoffs, evidence before claims",
    },
];

// --- Personal projects ---
const personal = [
    {
        id: "atlas",
        title: "Atlas",
        associated: "Personal data lakehouse",
        description: "A local-first data lakehouse that turns my scattered personal exports into structured, searchable data. Raw files land untouched, Python parsers normalize them into SQLite with full-text search, and curated, git-versioned records feed generated views for each AI tool. Search and summarization run on local models, and an explicit boundary rule decides what may ever reach a cloud model.",
        technologies: ["Python", "SQLite FTS5", "Markdown", "Git", "llama.cpp", "Ollama"],
        outcome: "Taught me idempotency, lineage, and why AI shouldn't own the data",
        featured: true,
    },
    {
        id: "no-whey",
        title: "No-Whey",
        associated: "Live app",
        description: "A dairy-ingredient checker that returns SAFE, UNSAFE, or REVIEW REQUIRED with a plain-language explanation. It catches what labels hide: casein in \"non-dairy\" products, milk-derived additives, and vague terms. Rules live in YAML so the logic stays auditable; product lookups enrich the result.",
        technologies: ["FastAPI", "JavaScript", "PWA", "YAML", "OpenFoodFacts"],
        outcome: "Live, with a real beta tester",
        liveUrl: "https://no-whey.onrender.com",
    },
    {
        id: "cinemetrics",
        title: "Cinemetrics",
        associated: "SavvyCoders capstone · still maintained",
        description: "A movie, TV, and gaming discovery app built from scratch with no framework: native ES modules, a hand-rolled component layer, client-side routing, and an Express + MongoDB API over TMDB data. I've kept shipping to it since graduation, including security hardening for untrusted API text.",
        technologies: ["JavaScript", "Node.js", "Express", "MongoDB", "Navigo", "TMDB API"],
        outcome: "100+ commits, still shipping after graduation",
        githubUrl: savvyRepo,
        liveUrl: "https://capstonesavvycoders.netlify.app/",
    },
    {
        id: "bait-and-switch",
        title: "Bait & Switch",
        associated: "Personal project",
        description: "A Midwest angler's map and field guide: 200+ curated lakes and rivers, a species catalog, a live overlay of Illinois lake-depth data from the state's ArcGIS service, and boat ramps and piers from OpenStreetMap with fallback across mirrors. No backend; state lives in the browser.",
        technologies: ["React", "Vite", "Leaflet", "Tailwind", "OpenStreetMap"],
        outcome: "Live public geodata in a working map",
        liveUrl: "https://bait-and-switch-ruddy.vercel.app",
    },
    {
        id: "garden-os",
        title: "Garden OS",
        associated: "Personal project",
        description: "My garden as a data system: registries for areas, zones, and plants, observation and harvest logs, weather inputs, a generated daily hub, and a phone-friendly form backed by a small local server that writes observations back into the dataset.",
        technologies: ["Python", "CSV", "HTML", "Open-Meteo"],
        outcome: "Observe, decide, act, and check the outcome",
    },
    {
        id: "local-ai-lab",
        title: "Local AI lab",
        associated: "Personal project",
        description: "Image and language models running entirely on a 12 GB laptop GPU: LoRA training with checkpoint-by-checkpoint evaluation, a ComfyUI pipeline with face correction and 4x upscaling, and 30B-class language models on llama.cpp. Most of the work was measuring and fitting into memory, not picking models.",
        technologies: ["ComfyUI", "SDXL", "kohya", "PyTorch", "llama.cpp", "Ollama"],
        outcome: "Measured model quality instead of guessing",
    },
];

// --- Building now ---
const buildingNow = [
    {
        title: "Watt in Tarnation",
        body: "A hands-on solar lab in my garage for learning DC power, MPPT, sensing, and telemetry from first principles. Every component decision is logged with its datasheet math, and nothing gets bought until the measurements exist.",
        tech: "ESP32 · MicroPython · INA228 · solar PV",
    },
    {
        title: "Solar compute demonstrator",
        body: "The next step: putting a real computer workload behind a small solar + battery system to explore telemetry, load shedding, and energy-aware computing at miniature data-center scale.",
        tech: "Salvaged PC hardware · ESP32 · Python · SQLite",
    },
];

// --- TripleTen Data Science program (16 projects, compact view) ---
type TTProject = {
    title: string;
    description: string;
    tech: string;
    outcome?: string;
};

const tripleten: TTProject[] = [
    {
        title: "Customer Retention Prediction (Telecom)",
        description: "Predicted contract cancellations so marketing could reach at-risk customers before they churned.",
        tech: "Random Forest · Logistic Regression · CNN · TensorFlow",
        outcome: "AUC-ROC ≥ 0.75",
    },
    {
        title: "Car Price Prediction",
        description: "Gradient-boosted model estimating used-car market value with a focus on prediction speed as well as accuracy.",
        tech: "CatBoost · LightGBM · XGBoost · scikit-learn",
        outcome: "Fast tuned GBM beat baseline linear",
    },
    {
        title: "Movie Review Sentiment",
        description: "NLP pipeline flagging negative movie reviews for sentiment tracking.",
        tech: "NLTK · spaCy · transformers · LightGBM",
        outcome: "Multi-model NLP with transformer features",
    },
    {
        title: "Taxi Orders Forecasting",
        description: "Hourly forecast of taxi demand to help optimize fleet scheduling.",
        tech: "statsmodels · scikit-learn · LightGBM",
        outcome: "RMSE ≤ 48 on hourly forecast",
    },
    {
        title: "Cell Phone Plan Recommender",
        description: "Classification model that picks the best cell plan for a customer from usage patterns.",
        tech: "scikit-learn · Decision Tree · Random Forest · Logistic Regression",
        outcome: "Accuracy ≥ 0.75",
    },
    {
        title: "Bank Client Retention",
        description: "Predicted which bank customers were likely to leave so retention could be targeted.",
        tech: "scikit-learn · Random Forest · Logistic Regression",
        outcome: "F1 ≥ 0.59",
    },
    {
        title: "Credit Scoring Analysis",
        description: "Evaluated borrower metrics to predict the likelihood of loan default.",
        tech: "Python · pandas",
        outcome: "Identified drivers of default risk",
    },
    {
        title: "Oil Well Location Selection",
        description: "Validated reserve volume models and calculated profit/risk trade-offs across candidate drilling regions.",
        tech: "scikit-learn · Linear Regression · Bootstrap",
        outcome: "Best risk-adjusted region selected",
    },
    {
        title: "Gold Recovery Modeling",
        description: "Modeled the gold-mining recovery process to surface efficiency improvements.",
        tech: "scikit-learn · Linear Regression · Decision Tree · Random Forest",
        outcome: "Prototype model for industrial use",
    },
    {
        title: "Insurance Benefit Modeling",
        description: "Identified similar customers and predicted insurance benefit amounts while preserving data privacy.",
        tech: "scikit-learn · KNN · seaborn",
        outcome: "Privacy-aware similarity + benefit model",
    },
    {
        title: "Vehicle Price Analysis",
        description: "Investigated which features drive used-vehicle prices in classified ads.",
        tech: "pandas · NumPy · Matplotlib",
        outcome: "Feature-importance report for pricing",
    },
    {
        title: "Video Game Sales Hypothesis Testing",
        description: "Tested hypotheses on user vs. critic scores to pick promising platforms and ad directions.",
        tech: "pandas · SciPy · Matplotlib",
        outcome: "Statistically validated recommendations",
    },
    {
        title: "Taxi Trips vs. Weather",
        description: "Tested whether weather conditions meaningfully shift taxi trip duration.",
        tech: "pandas · SciPy",
        outcome: "Hypothesis test on real trip data",
    },
    {
        title: "Cell Plan Revenue Analysis",
        description: "Analyzed client behavior across telecom packages to identify which plans generate the most revenue.",
        tech: "pandas · SciPy · Matplotlib",
        outcome: "Revenue-driver segmentation",
    },
    {
        title: "Music Preferences Across Cities",
        description: "Compared listening habits between two cities to surface patterns in music preference.",
        tech: "Python · pandas",
        outcome: "First end-to-end EDA project",
    },
    {
        title: "Learning Coach Effectiveness Analysis",
        description: "End-to-end DS workflow — cleaning, modeling, evaluation — focused on performance metrics and outcome prediction.",
        tech: "Python · scikit-learn · pandas",
        outcome: "Full workflow, performance metrics reported",
    },
];

const description = "What James Nguyen has built: internal finance and operations systems, a personal data lakehouse, live web apps, a local AI lab, and 16 data science projects.";
---

<Layout title="Projects" description={description}>
    <section class="projects-header">
        <h1>Projects</h1>
        <p>
            Systems I run at work, things I build on my own time, and where I started. Each card
            says what it does, what came out of it, and the stack. Nothing here is a mockup.

        </p>
    </section>

    <section class="projects-section">
        <h2>Built at work <span class="badge">Day &amp; Night Solar</span></h2>
        <p class="section-intro">
            The internal systems a commercial solar and energy-storage contractor runs its back office on.
            I'm the sole developer. The code is private, so these describe what each system does and how
            it's designed, with no company data. The <a href="/blog#lessons" class="repo-link">lessons</a> go deeper.
        </p>
        <div class="projects-grid">
            {systems.map(p => <ProjectCard {...p} />)}
        </div>
    </section>

    <section class="projects-section">
        <h2>Personal projects</h2>
        <p class="section-intro">Things I build to learn, and keep using.</p>
        <div class="projects-grid">
            {personal.map(({ id, ...p }) => <div id={id} class="anchor"><ProjectCard {...p} /></div>)}
        </div>
    </section>

    <section class="projects-section">
        <h2>Building now</h2>
        <div class="now-grid">
            {buildingNow.map(b => (
                <article class="now-card">
                    <span class="now-tag">In progress</span>
                    <h3>{b.title}</h3>
                    <p>{b.body}</p>
                    <p class="tt-tech">{b.tech}</p>
                </article>
            ))}
        </div>
    </section>

    <section class="projects-section">
        <h2>Data science foundations</h2>
        <p class="section-intro">
            16 end-to-end projects from the TripleTen program: churn, pricing, forecasting, NLP, and computer
            vision. Highlights: telecom churn with CatBoost (AUC-ROC 0.844) and a CNN that estimates age from photos.
            Code and notebooks are in the <a href={tripleTenRepo} target="_blank" rel="noopener" class="repo-link">TripleTenProgram</a> repo.
        </p>
        <details class="tt-details">
            <summary>Show all 16 projects</summary>
        <div class="tt-grid">
            {tripleten.map(p => (
                <article class="tt-card">
                    <h3>{p.title}</h3>
                    <p class="tt-desc">{p.description}</p>
                    {p.outcome && <p class="tt-outcome">{p.outcome}</p>}
                    <p class="tt-tech">{p.tech}</p>
                </article>
            ))}
        </div>
        </details>
    </section>
</Layout>

<style>
    .projects-header { margin: 4rem 0 3rem; max-width: 780px; }
    .projects-header h1 { font-size: 3rem; margin-bottom: 1rem; }
    .projects-header p {
        color: #ccc;
        font-size: 1.1rem;
        line-height: 1.7;
    }

    .projects-section { margin: 3rem 0; }
    .anchor { scroll-margin-top: 6rem; display: flex; }
    .anchor > :global(*) { flex: 1; }
    .now-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
    .now-card {
        padding: 1.25rem;
        border: 1px dashed #333;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .now-tag { color: var(--accent); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; }
    .now-card h3 { font-size: 1.05rem; color: #eee; }
    .now-card p { color: #aaa; font-size: 0.9rem; line-height: 1.55; }
    .tt-details summary {
        cursor: pointer;
        color: #ddd;
        font-size: 0.9rem;
        padding: 0.6rem 0;
        margin-bottom: 0.75rem;
    }
    .tt-details summary:hover { color: #fff; }
    .projects-section h2 {
        font-size: 1.5rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #222;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }
    .badge {
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #3a5;
        border: 1px solid #3a5;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-weight: 400;
    }
    .section-intro {
        color: #aaa;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.25rem;
        max-width: 780px;
    }
    .repo-link {
        color: #ddd;
        text-decoration: none;
        border-bottom: 1px solid #444;
    }
    .repo-link:hover { color: #fff; border-color: #fff; }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.25rem;
    }

    .tt-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 0.75rem;
    }
    .tt-card {
        padding: 1rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid #1f1f1f;
        border-radius: 8px;
        transition: border-color 0.2s;
    }
    .tt-card:hover { border-color: #333; }
    .tt-card h3 {
        font-size: 0.95rem;
        margin: 0 0 0.4rem;
        color: #eee;
    }
    .tt-desc { color: #aaa; font-size: 0.85rem; line-height: 1.5; margin: 0 0 0.4rem; }
    .tt-outcome {
        color: #7fc995;
        font-size: 0.78rem;
        margin: 0 0 0.35rem;
    }
    .tt-tech {
        color: #666;
        font-size: 0.72rem;
        margin: 0;
        letter-spacing: 0.01em;
    }
</style>
