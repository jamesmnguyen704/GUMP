---
import Logo from '../components/Logo.astro';
import SocialIcons from '../components/SocialIcons.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "James Nguyen — Data & AI Engineer with a 10+ year finance background. Turning messy operations into intelligent systems at the intersection of accounting, data, and automation.",
	image = "/favicon.svg",
} = Astro.props;

const siteName = "James Nguyen";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="James Nguyen" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{fullTitle}</title>
	</head>
	<body>
		<header>
			<nav>
				<a href="/" class="logo" aria-label="Home">
					<Logo initials="JN" fullName="jamesnguyen" />
				</a>
				<div class="nav-links">
					<a href="/about">About</a>
					<a href="/work">Work</a>
					<a href="/projects">Projects</a>
					<a href="/blog">Writing</a>
					<a href="mailto:jamesmnguyen704@outlook.com" class="contact-btn">Contact</a>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-inner">
				<p class="footer-copy">&copy; {new Date().getFullYear()} James Nguyen</p>
				<SocialIcons size="sm" />
			</div>
		</footer>
	</body>
</html>
<style is:global>
	:root {
		--text-color: #eaeaea;
		--text-muted: #9a9a9a;
		--bg-color: #0a0a0a;
		--bg-elev: #111;
		--border: #222;
		--accent: #d9a33e;
	}
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	html {
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		background: var(--bg-color);
		color: var(--text-color);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	body {
		max-width: 1140px;
		margin: 0 auto;
		padding: 0 1.5rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		padding: 1.25rem 0;
		background: rgba(10, 10, 10, 0.78);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s;
	}
	header::after {
		content: "";
		position: absolute;
		inset: auto 0 0 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--border), transparent);
		opacity: 0.6;
	}
	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}
	.logo {
		display: inline-flex;
		color: var(--text-color);
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		gap: 1.75rem;
		align-items: center;
	}
	.nav-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.92rem;
		transition: color 0.15s;
	}
	.nav-links a:hover {
		color: var(--text-color);
	}
	.contact-btn {
		border: 1px solid rgba(255, 255, 255, 0.18);
		padding: 0.45rem 0.9rem;
		border-radius: 6px;
		color: var(--text-color) !important;
		transition: border-color 0.15s, background 0.15s;
	}
	.contact-btn:hover {
		border-color: var(--text-color);
		background: rgba(255, 255, 255, 0.04);
	}
	main {
		flex: 1;
		padding: 1.5rem 0 4rem;
	}
	footer {
		padding: 3rem 0 2rem;
		margin-top: 4rem;
		border-top: 1px solid var(--border);
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}
	.footer-copy {
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	a { color: inherit; }

	@media (max-width: 720px) {
		.nav-links { gap: 0.75rem; }
		.nav-links a { font-size: 0.85rem; }
	}
	@media (max-width: 500px) {
		.nav-links > a[href="/about"],
		.nav-links > a[href="/work"] { display: none; }
	}
</style>
