---
import Logo from '../components/Logo.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "James Nguyen — Data & AI Engineer with a 10+ year finance background. Turning messy operations into intelligent systems at the intersection of accounting, data, and automation.",
	image = "/favicon.svg",
} = Astro.props;

const siteName = "James Nguyen";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="James Nguyen" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImage} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{fullTitle}</title>
	</head>
	<body>
		<header>
			<nav>
				<div class="logo">
					<Logo initials="JN" fullName="jamesnguyen" />
				</div>
				<div class="nav-links">
					<a href="/">Home</a>
					<a href="/about">About</a>
					<a href="/work">Work</a>
					<a href="/projects">Projects</a>
					<a href="/learning">Learning</a>
					<a href="/blog">Blog</a>
					<a href="/favorites">Favorites</a>
					<div class="contact-container">
						<a href="mailto:jamesmnguyen704@outlook.com" class="contact-btn">Contact</a>
						<div class="contact-info">
							<p><a href="mailto:jamesmnguyen704@outlook.com">jamesmnguyen704@outlook.com</a></p>
							<p><a href="https://github.com/jamesmnguyen704" target="_blank" rel="noopener">GitHub</a></p>
							<p><a href="https://www.linkedin.com/in/jamesmnguyen704/" target="_blank" rel="noopener">LinkedIn</a></p>
						</div>
					</div>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
<style is:global>
	:root {
		--text-color: #ffffff;
		--bg-color: #000000;
		--accent-color: #666666;
	}
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	html {
		font-family: system-ui, sans-serif;
		background: var(--bg-color);
		color: var(--text-color);
	}
	body {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	header {
		padding: 2rem 0;
	}
	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.nav-links {
		display: flex;
		gap: 2rem;
		align-items: center;
	}
	.nav-links a {
		color: var(--text-color);
		text-decoration: none;
		font-size: 1rem;
	}
	.contact-container {
		position: relative;
	}
	.contact-btn {
		border: 1px solid var(--text-color);
		padding: 0.5rem 1rem;
		border-radius: 4px;
	}
	.contact-info {
		position: absolute;
		top: 100%;
		right: 0;
		background-color: var(--bg-color);
		border: 1px solid var(--text-color);
		padding: 1rem;
		border-radius: 4px;
		margin-top: 0.5rem;
		display: none;
		white-space: nowrap;
		z-index: 10;
	}
	.contact-info p {
		margin: 0.5rem 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.contact-container:hover .contact-info {
		display: block;
	}
	.outlook-icon, .discord-icon {
		width: 20px;
		height: 20px;
	}
	.outlook-icon {
		color: #0078D4;
	}
	.discord-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-color) !important;
	}
	main {
		padding: 2rem 0;
	}
</style>