---
interface Props {
    title: string;
    description: string;
    technologies: string[];
    githubUrl: string;
    outcome?: string;
    featured?: boolean;
}

const { title, description, technologies, githubUrl, outcome, featured } = Astro.props;
---

<article class={`project-card${featured ? " featured" : ""}`}>
    {featured && <span class="featured-badge">Featured</span>}
    <h3 class="title">{title}</h3>
    <p class="description">{description}</p>

    {outcome && (
        <div class="outcome">
            <span class="outcome-label">Result</span>
            <span class="outcome-value">{outcome}</span>
        </div>
    )}

    <div class="technologies">
        {technologies.map(tech => <span class="tech-tag">{tech}</span>)}
    </div>

    <div class="links">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="github-link">
            View on GitHub <span aria-hidden="true">&rarr;</span>
        </a>
    </div>
</article>

<style>
    .project-card {
        position: relative;
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform 0.2s ease, border-color 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .project-card:hover {
        transform: translateY(-3px);
        border-color: #4a4a4a;
    }
    .project-card.featured {
        border-color: #3a5;
        background: linear-gradient(180deg, #0e1a12 0%, #0a0a0a 100%);
    }
    .featured-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #3a5;
        color: #000;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-weight: 600;
    }
    .title {
        font-size: 1.25rem;
        margin: 0;
        color: #fff;
        line-height: 1.3;
        padding-right: 5rem;
    }
    .description {
        color: #bbb;
        line-height: 1.55;
        margin: 0;
        font-size: 0.95rem;
    }
    .outcome {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.6rem 0.8rem;
        background: rgba(255, 255, 255, 0.04);
        border-left: 2px solid #3a5;
        border-radius: 4px;
    }
    .outcome-label {
        color: #888;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .outcome-value {
        color: #eee;
        font-size: 0.9rem;
        font-weight: 500;
    }
    .technologies {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }
    .tech-tag {
        background: rgba(255, 255, 255, 0.06);
        color: #ddd;
        padding: 0.2rem 0.6rem;
        border-radius: 12px;
        font-size: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .links {
        margin-top: auto;
        padding-top: 0.25rem;
    }
    .github-link {
        color: #ccc;
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.2s ease;
    }
    .github-link:hover {
        color: #fff;
    }
</style>
