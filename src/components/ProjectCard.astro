---
interface Props {
    title: string;
    description: string;
    technologies: string[];
    githubUrl?: string;
    sourceUrl?: string;
    sourceLabel?: string;
    liveUrl?: string;
    outcome?: string;
    featured?: boolean;
    associated?: string;
}

const {
    title,
    description,
    technologies,
    githubUrl,
    sourceUrl,
    sourceLabel,
    liveUrl,
    outcome,
    featured,
    associated,
} = Astro.props;

const source = sourceUrl ?? githubUrl;
const sourceText = sourceLabel ?? (sourceUrl ? "View source" : "View on GitHub");
---

<article class={`project-card${featured ? " featured" : ""}`}>
    {featured && <span class="featured-badge">Featured</span>}
    <h3 class="title">{title}</h3>
    {associated && <p class="associated">{associated}</p>}
    <p class="description">{description}</p>

    {outcome && (
        <div class="outcome">
            <span class="outcome-label">Result</span>
            <span class="outcome-value">{outcome}</span>
        </div>
    )}

    <div class="technologies">
        {technologies.map(tech => <span class="tech-tag">{tech}</span>)}
    </div>

    <div class="links">
        {liveUrl && (
            <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="link-item link-primary">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
                View live
            </a>
        )}
        {source && (
            <a href={source} target="_blank" rel="noopener noreferrer" class="link-item">
                {sourceText} <span aria-hidden="true">&rarr;</span>
            </a>
        )}
    </div>
</article>

<style>
    .project-card {
        position: relative;
        background: #111;
        border: 1px solid #2a2a2a;
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform 0.2s ease, border-color 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }
    .project-card:hover {
        transform: translateY(-3px);
        border-color: #4a4a4a;
    }
    .project-card.featured {
        border-color: #3a5;
        background: linear-gradient(180deg, #0e1a12 0%, #0a0a0a 100%);
    }
    .featured-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #3a5;
        color: #000;
        font-size: 0.65rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-weight: 600;
    }
    .title {
        font-size: 1.2rem;
        margin: 0;
        color: #fff;
        line-height: 1.3;
        padding-right: 5rem;
    }
    .associated {
        color: #888;
        font-size: 0.78rem;
        margin: 0;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }
    .description {
        color: #bbb;
        line-height: 1.55;
        margin: 0;
        font-size: 0.92rem;
    }
    .outcome {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: rgba(255, 255, 255, 0.04);
        border-left: 2px solid #3a5;
        border-radius: 4px;
    }
    .outcome-label {
        color: #888;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .outcome-value {
        color: #eee;
        font-size: 0.85rem;
        font-weight: 500;
    }
    .technologies {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }
    .tech-tag {
        background: rgba(255, 255, 255, 0.05);
        color: #ccc;
        padding: 0.2rem 0.55rem;
        border-radius: 12px;
        font-size: 0.72rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .links {
        margin-top: auto;
        padding-top: 0.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
    }
    .link-item {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: #bbb;
        text-decoration: none;
        font-size: 0.82rem;
        transition: color 0.15s;
    }
    .link-item:hover { color: #fff; }
    .link-item.link-primary {
        color: #eee;
        font-weight: 500;
    }
    .link-item.link-primary:hover {
        color: #fff;
    }
</style>
