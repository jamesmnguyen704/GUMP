---

<div class="work-experience">
    {experiences.map((exp) => (
        <article class={`experience-item${exp.highlight ? " highlight" : ""}`}>
            <div class="company-header">
                <h3>{exp.position}</h3>
                <div class="meta">
                    <span class="company">{exp.company}</span>
                    <span class="dot-sep" aria-hidden="true">·</span>
                    <span class="type">{exp.type}</span>
                    <span class="dot-sep" aria-hidden="true">·</span>
                    <span class="duration">{exp.duration}</span>
                </div>
                <span class="location">{exp.location}</span>
            </div>

            {exp.summary && <p class="summary">{exp.summary}</p>}

            <ul class="responsibilities">
                {exp.responsibilities.map(item => <li>{item}</li>)}
            </ul>

            {exp.skills && exp.skills.length > 0 && (
                <div class="skills">
                    <div class="skill-tags">
                        {exp.skills.map(skill => <span class="skill-tag">{skill}</span>)}
                    </div>
                </div>
            )}
        </article>
    ))}
</div>

<style>
    .work-experience {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .experience-item {
        border-left: 2px solid #333;
        padding-left: 1.5rem;
        position: relative;
    }
    .experience-item::before {
        content: '';
        position: absolute;
        left: -5px;
        top: 0.4rem;
        width: 8px;
        height: 8px;
        background: #666;
        border-radius: 50%;
    }
    .experience-item.highlight {
        border-left-color: #3a5;
        background: linear-gradient(90deg, rgba(58,170,85,0.04), transparent 40%);
        padding: 0.5rem 1rem 1rem 1.5rem;
        border-radius: 0 8px 8px 0;
    }
    .experience-item.highlight::before { background: #3a5; }

    .company-header { margin-bottom: 0.75rem; }
    .company-header h3 { font-size: 1.3rem; margin: 0 0 0.35rem; }

    .meta {
        color: #aaa;
        font-size: 0.9rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
    }
    .meta .company { color: #ddd; }
    .dot-sep { color: #555; }
    .location {
        display: block;
        font-size: 0.82rem;
        color: #888;
        margin-top: 0.2rem;
    }

    .summary {
        color: #ddd;
        line-height: 1.6;
        margin: 0.8rem 0 0.5rem;
        font-style: italic;
    }

    .responsibilities {
        margin: 0.75rem 0 1rem;
        padding-left: 1.25rem;
    }
    .responsibilities li {
        margin-bottom: 0.4rem;
        line-height: 1.6;
        color: #ccc;
        font-size: 0.95rem;
    }

    .skills { margin-top: 0.75rem; }
    .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }
    .skill-tag {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.2rem 0.6rem;
        border-radius: 12px;
        font-size: 0.78rem;
        color: #ccc;
    }
</style>
