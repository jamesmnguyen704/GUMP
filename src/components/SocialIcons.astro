---

<ul class={`social-icons size-${size} align-${align} variant-${variant}`}>
    {links.map(link => (
        <li>
            <a
                href={link.href}
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                aria-label={link.label}
                title={link.label}
            >
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={link.svg} />
            </a>
        </li>
    ))}
</ul>

<style>
    .social-icons {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }
    .align-center { justify-content: center; }
    .align-end { justify-content: flex-end; }

    .social-icons a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #aaa;
        transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.2s;
    }
    .social-icons a:hover {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.6);
        background: rgba(255, 255, 255, 0.04);
        transform: translateY(-2px);
    }
    .social-icons svg {
        width: 18px;
        height: 18px;
    }

    .size-sm a { width: 34px; height: 34px; }
    .size-sm svg { width: 14px; height: 14px; }

    .size-lg a { width: 44px; height: 44px; }
    .size-lg svg { width: 20px; height: 20px; }

    .variant-solid a {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .variant-solid a:hover {
        background: rgba(255, 255, 255, 0.1);
    }
</style>
